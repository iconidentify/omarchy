#!/bin/bash
# omarchy:summary=Transition Apple Silicon support to the omarchy-mac add-on
# omarchy:args=[--system|--user]
# omarchy:hidden=true
set -euo pipefail
scope=${1:-all}
case $scope in
  all|--system|--user) ;;
  *) echo "Usage: omarchy-setup-mac [--system|--user]" >&2; exit 2 ;;
esac
(( $# <= 1 )) || exit 2
omarchy-hw-apple-silicon || exit 0
# Migrations run in the update terminal. Acquire from the configured signed
# repository; do not silently fall back to an AUR recipe or change trust.
if ! pacman -Q omarchy-mac >/dev/null 2>&1; then
  sudo env OMARCHY_UPDATE_PACMAN=1 pacman -S --needed --noconfirm omarchy-mac
fi
if [[ $scope != "--user" ]]; then
  sudo omarchy-mac-setup-system
fi
if [[ $scope != "--system" ]]; then
  omarchy-mac-setup-user
fi
